{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Main local workbench window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/Exaaiser/LayerSift" },
        { "url": "https://github.com/Exaaiser/LayerSift/blob/main/README.md" }
      ]
    }
  ]
}
